MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/pavr_website?retryWrites=true&w=majority
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://pavrtools.com,https://www.pavrtools.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me

# Gmail SMTP — use an App Password, not the account password
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
NOTIFY_EMAIL=your@gmail.com
